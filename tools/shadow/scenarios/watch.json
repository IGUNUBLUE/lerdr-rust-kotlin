{
  "name": "watch",
  "vars": {
    "pane_id": "wE:p1",
    "workspace_id": "wE",
    "target": {
      "server_session_id": "primary",
      "pane_id": "wE:p1",
      "terminal_id": "term-1",
      "generation": 0,
      "agent_session_id": ""
    },
    "watch_base": "watch baseline line 01\nwatch baseline line 02\nwatch baseline line 03\nwatch baseline line 04\nwatch baseline line 05\nwatch baseline line 06\nwatch baseline line 07\nwatch baseline line 08\nwatch baseline line 09\nwatch baseline line 10\nwatch baseline line 11\nwatch baseline line 12\n",
    "watch_next": "watch baseline line 01\nwatch baseline line 02\nwatch baseline line 03\nwatch baseline line 04\nwatch baseline line 05\nwatch baseline line 06\nwatch baseline line 07\nwatch baseline line 08\nwatch baseline line 09\nwatch baseline line 10\nwatch baseline line 11\nwatch baseline line 12\nappended line 13\n"
  },
  "compare": {
    "drop_types": [
      "e2ee_server_hello",
      "action_receipt",
      "inventory_status"
    ],
    "unordered_types": [
      "push_config",
      "herdr_status",
      "workspaces",
      "agents",
      "activity_history",
      "inventory_status",
      "capabilities",
      "update_status",
      "speech_voices",
      "agent_profiles",
      "push_policy",
      "activity"
    ],
    "drop_keys": [
      "_server_received_at",
      "_server_sequence",
      "at",
      "id",
      "created_at",
      "updated_at",
      "paired_at_ms",
      "last_seen_at_ms",
      "expires_at_ms",
      "started_at",
      "completed_at",
      "timestamp",
      "ts",
      "idle_since",
      "last_active_at",
      "received_at_ms",
      "content_fingerprint",
      "base_fingerprint",
      "last_seen_at",
      "target"
    ],
    "type_drop_keys": {
      "push_config": [
        "agent_profiles",
        "app_deploy",
        "capabilities",
        "herdr_status",
        "home",
        "host",
        "inventory",
        "speech_languages",
        "update",
        "vapid_public_key",
        "version",
        "release_version",
        "revision"
      ],
      "herdr_status": [
        "features",
        "generation",
        "surface_interest",
        "capabilities"
      ],
      "agents": [
        "activity_seq",
        "pane_revision",
        "project",
        "raw_pane_id",
        "tab_label",
        "tab_number",
        "tab_order",
        "updated_at",
        "tokens",
        "state_labels"
      ],
      "workspaces": [
        "cwd",
        "tokens",
        "worktree"
      ],
      "activity": [
        "project",
        "session",
        "session_name",
        "host"
      ],
      "activity_history": [
        "project",
        "session",
        "session_name",
        "host"
      ],
      "pane_content": [
        "attention_kind",
        "command",
        "no_echo",
        "no_echo_prompt",
        "options",
        "prompt"
      ],
      "pane_delta": [
        "attention_kind",
        "command",
        "no_echo",
        "no_echo_prompt",
        "options",
        "prompt"
      ]
    },
    "map_keys": [
      "device_id",
      "credential_id",
      "credential_secret",
      "vapid_public_key",
      "host",
      "home",
      "version",
      "release_version",
      "revision",
      "machine_id",
      "instance_id",
      "socket_path",
      "endpoint",
      "public_key",
      "proof",
      "nonce",
      "url"
    ],
    "async_dedupe": true,
    "notes": [
      "action_receipt is Rust's v3 dispatch-evidence addition — Go has no counterpart; dropped (census still shows it).",
      "inventory_status is a Go-only inventory-poller frame; dropped.",
      "Watch frames compare {type,pane_id,ack_required,content/segments,format,truncated,viewport_only/viewport_rows,resize_settling,interaction,question_layout,target}: fingerprints (content_fingerprint, base_fingerprint) are content-derived and dropped globally.",
      "pane_content/pane_delta drop only Go's classification/no-echo projection keys (attention_kind, prompt, command, options, no_echo, no_echo_prompt) — Rust emits format, truncated, viewport_only/viewport_rows, resize_settling, interaction:null and question_layout:false on watch pushes like the oracle's unclassified seeds.",
      "Go's watch is ticker-driven; Rust's is tick + invalidation-assisted — the pane_updated emit is a wake nudge, not a requirement, and arrival timing inside the collect window is scheduler-owned.",
      "Go pushes an empty activity_history at connect; drop_matches removes only the null-activities variant.",
      "control.set seeds pane content before watch_pane so the shared fake is deterministic across both runs of a diff."
    ],
    "drop_matches": [
      {
        "type": "activity_history",
        "contains": {
          "activities": null
        }
      }
    ]
  },
  "steps": [
    {
      "op": "expect",
      "label": "startup-push-config",
      "match": {
        "type": "push_config"
      },
      "timeout_ms": 8000
    },
    {
      "op": "expect",
      "label": "startup-workspaces",
      "match": {
        "type": "workspaces",
        "contains": {
          "workspaces": [
            {
              "workspace_id": "{workspace_id}"
            }
          ]
        }
      }
    },
    {
      "op": "expect",
      "label": "startup-agents",
      "match": {
        "type": "agents",
        "contains": {
          "agents": [
            {
              "pane_id": "{pane_id}"
            }
          ]
        }
      }
    },
    {
      "op": "settle",
      "label": "startup-settle",
      "ms": 600
    },
    {
      "op": "fence",
      "label": "startup-done"
    },
    {
      "op": "fake_call",
      "label": "seed-content",
      "method": "control.set",
      "params": {
        "pane_id": "{pane_id}",
        "text": "{watch_base}"
      }
    },
    {
      "op": "send",
      "label": "watch-pane",
      "request_id": "req-wp",
      "frame": {
        "type": "watch_pane",
        "protocol": 3,
        "request_id": "{request_id}",
        "pane_id": "{pane_id}",
        "lines": 30,
        "interval_ms": 250,
        "format": "text",
        "target": "{target}"
      },
      "capture": [
        "pane_content",
        "pane_delta",
        "pane_resync",
        "pane_unchanged"
      ],
      "until": {
        "type": "pane_content",
        "contains": {
          "pane_id": "{pane_id}"
        }
      },
      "timeout_ms": 5000,
      "quiesce_ms": 400
    },
    {
      "op": "expect",
      "label": "initial-pane-content",
      "match": {
        "type": "pane_content",
        "contains": {
          "pane_id": "{pane_id}",
          "ack_required": true
        }
      },
      "timeout_ms": 3000
    },
    {
      "op": "ack_pane",
      "label": "ack-initial",
      "pane_id": "{pane_id}",
      "target": "{target}",
      "capture": [
        "pane_resync"
      ],
      "timeout_ms": 2000,
      "quiesce_ms": 400
    },
    {
      "op": "settle",
      "label": "post-ack-settle",
      "ms": 300
    },
    {
      "op": "fake_call",
      "label": "mutate-content",
      "method": "control.set",
      "params": {
        "pane_id": "{pane_id}",
        "text": "{watch_next}"
      }
    },
    {
      "op": "fake_call",
      "label": "emit-pane-updated",
      "method": "control.emit",
      "params": {
        "name": "pane_updated",
        "data": {
          "pane_id": "{pane_id}"
        }
      }
    },
    {
      "op": "collect",
      "label": "watch-delta",
      "capture": [
        "pane_content",
        "pane_delta",
        "pane_resync"
      ],
      "until": {
        "type": "pane_delta",
        "contains": {
          "pane_id": "{pane_id}"
        }
      },
      "timeout_ms": 6000,
      "quiesce_ms": 600
    },
    {
      "op": "ack_pane",
      "label": "ack-delta",
      "pane_id": "{pane_id}",
      "target": "{target}",
      "capture": [
        "pane_content",
        "pane_delta",
        "pane_resync"
      ],
      "timeout_ms": 2000,
      "quiesce_ms": 400
    },
    {
      "op": "send",
      "label": "unwatch-pane",
      "request_id": "req-uw",
      "frame": {
        "type": "unwatch_pane",
        "protocol": 3,
        "request_id": "{request_id}",
        "pane_id": "{pane_id}",
        "target": "{target}"
      },
      "capture": [
        "pane_content",
        "pane_delta",
        "pane_resync"
      ],
      "timeout_ms": 2000,
      "quiesce_ms": 600
    },
    {
      "op": "collect",
      "label": "drain",
      "timeout_ms": 2000,
      "quiesce_ms": 500
    }
  ]
}
